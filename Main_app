def view_patients():
    cursor.execute('SELECT*FROM patients')
    records=cursor.fetchall()

    print("\n---Current Patients---")
    if not records:
            print("No patients found in the database.")
    else:
        for row in records:
            print(f"ID:{row[0]} | Name:{row[1]} | Age:{row[2]} | Illness:{row[3]}")
            print("------------\n")
    
def search_name():
    search_name=input("\nEnter the name of the patient you are looking for:")
    cursor.execute("SELECT * FROM patients WHERE name LIKE ?", ('%' + search_name + '%',))
    records=cursor.fetchall()

    print("\n--- search results ---")
    if not records: 
        print(f"No patients with that name found in the database'{search_name}'.")
    else:
        for row in records:
            print(f"ID:{row[0]} | Name:{row[1]} | Age:{row[2]} | Illness:{row[3]}")
    print("------------\n")     

