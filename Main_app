def view_patients():
    cursor.execute('SELECT*FROM patients')
    records=cursor.fetchall()

    print("\n---Current Patients---")
    if not records:
            print("No patients found in the database.")
    else:
        for row in records:
            print(f"ID:{row[0]} | Name:{row[1]} | Age:{row[2]} | Illness:{row[3]}")
            print("------------\n")
    

